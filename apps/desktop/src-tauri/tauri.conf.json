{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "时奕教务排课",
  "version": "0.1.2",
  "identifier": "tech.karios.stt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "时奕教务排课",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRjMyRDlBMzE2RTA4QUIKUldTckNHNHhtaTN6NHVXcFdPNGk5WWI3M1k0Z1FyZXhmdW0yMkFEbWJNTTkwem95QjQrZ0FoSmgK",
      "endpoints": [
        "https://updates.karios.tech/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/stt-sidecar"],
    "resources": {
      "../../../config/services.yaml": "config/services.yaml",
      "../../../LICENSE": "legal/LICENSE.txt",
      "../../../NOTICE": "legal/NOTICE.txt",
      "../../../PRIVACY.md": "legal/PRIVACY.md",
      "../../../SECURITY.md": "legal/SECURITY.md",
      "../../../TRADEMARKS.md": "legal/TRADEMARKS.md",
      "../../../CODE_SIGNING_POLICY.md": "legal/CODE_SIGNING_POLICY.md",
      "../../../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../../../sidecar/stt_desktop/assets/fonts/OFL-1.1.txt": "legal/Noto-Sans-SC-OFL-1.1.txt",
      "../../../fixtures/mock/purchase.html": "mock/purchase.html"
    },
    "publisher": "杭州格若时科技有限公司",
    "copyright": "Copyright © 2026 杭州格若时科技有限公司",
    "shortDescription": "本地优先的中小学教务排课应用",
    "longDescription": "教务数据和排课算法完全保存在本机运行的跨平台桌面应用。",
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "450405c0-85b9-5bc5-a05c-de2bbb1e5805"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
